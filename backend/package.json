{
  "name": "drug-inventory-backend",
  "version": "1.0.0",
  "description": "Drug Inventory & Supply Chain Tracking App - Backend API",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node utils/seed.js",
    "seed:sample": "node utils/seedAdditional.js",
    "migrate": "node utils/migrate.js",
    "backup": "node utils/backup.js",
    "lint": "eslint .",
    "format": "prettier --write \"{config,constants,controllers,middleware,models,routes,services,utils,validators,tests}/**/*.js\" \"*.js\"",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand --coverage"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^10.2.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1"
  }
}
