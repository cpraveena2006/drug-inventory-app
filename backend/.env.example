PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/drug_inventory
JWT_SECRET=replace_with_a_long_random_secret_of_at_least_24_chars
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development
LOG_LEVEL=debug

# Optional outbound supplier email. Without SMTP, development logs a safe preview.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
